# Power Monitor MQTT Publisher Configuration
# Copy this file to ~/.config/power-monitor-mqtt/config and modify as needed

# MQTT broker settings
MQTT_HOST="mqtt.example.com"
MQTT_PORT="1883"
MQTT_USERNAME="pub_client"
MQTT_PASSWORD="your_mqtt_password"
# Set MQTT_TLS=true to encrypt the connection, usually with MQTT_PORT="8883".
# MQTT_CAFILE is the CA certificate that verifies the broker; leave it empty
# to use the system's trusted CA certificates.
MQTT_TLS=false
MQTT_CAFILE=""

# MQTT topic configuration
TOPIC_PREFIX="power-monitor"
DEVICE_NAME="$(hostname -s)"

# Monitoring interval in seconds
INTERVAL="60"

# SAP Power Monitor app path
POWER_MONITOR_PATH="/Applications/Power Monitor.app/Contents/MacOS/Power Monitor"

# Logging configuration
LOG_FILE="${HOME}/Library/Logs/power-monitor-mqtt/power-monitor-mqtt.log"
LOG_MAX_SIZE="1000000" # 1MB
LOG_MAX_FILES="4"
DEBUG_MODE=false
